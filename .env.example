# ==========================================
# A2 TalentBridge Environment Configuration
# ==========================================

# Core Application Settings
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="A2 TalentBridge"
NEXT_PUBLIC_TAGLINE="Bridging Talent, Education & Opportunity"

# Regional & Localization Defaults (Latvia / EU)
APP_COUNTRY=Latvia
APP_DEFAULT_CITY=Riga
APP_TIMEZONE=Europe/Riga
APP_LOCALE=en-LV
APP_CURRENCY=EUR
APP_PRIMARY_LANGUAGE=en
APP_SECONDARY_LANGUAGE=lv

# Database (PostgreSQL for production; SQLite dev fallback for zero-dependency local verification)
DATABASE_URL="file:./prisma/dev.db"
# Production example:
# DATABASE_URL="postgresql://postgres:password@localhost:5432/a2_talentbridge?schema=public"

# Authentication & Security
JWT_SECRET="a2_talentbridge_super_secret_jwt_key_riga_2026_dev_min_32_chars"
JWT_EXPIRES_IN="7d"
BCRYPT_SALT_ROUNDS=10

# GDPR & Privacy
GDPR_DATA_RETENTION_MONTHS=24
GDPR_DPO_EMAIL="dpo@a2talentbridge.lv"

# Feature Flags
ENABLE_MOCK_EMAIL_LOGS=true
ENABLE_PUBLIC_CREDENTIAL_VERIFICATION=true
